#!/bin/sh
# The all-int command.
#
# Two things this wrapper exists to do, both of which were footguns without it.
#
# It loads .env. The CLI reads process.env directly and has no dotenv, so every
# invocation without this either ran with no API key or silently used defaults -
# including writing to the wrong database. Shipping a .env.example while
# requiring the caller to export it by hand was a trap.
#
# And it works from any directory. The repo root is resolved from this script's
# own location, so the database path in .env stays correct no matter where you
# happen to be standing.
set -u

# Follow symlinks to find the real script, because `npm link` installs this as
# a symlink in a bin directory - and resolving $0 naively then points at that
# directory's parent rather than at the repo, so .env and the database are never
# found. Done by hand because readlink -f is not portable to macOS.
SELF=$0
while [ -L "$SELF" ]; do
  LINK=$(readlink "$SELF")
  case $LINK in
    /*) SELF=$LINK ;;
    *)  SELF=$(dirname -- "$SELF")/$LINK ;;
  esac
done
ROOT=$(CDPATH= cd -- "$(dirname -- "$SELF")/.." && pwd)
cd "$ROOT" || exit 1

if [ -f .env ]; then
  set -a
  # shellcheck disable=SC1091
  . ./.env
  set +a
fi

# The subscription backend refuses to use a claude.ai login while an API key is
# present, so the key is dropped when that backend is selected.
if [ "${ALLINT_LLM_PROVIDER:-anthropic}" = "claude-cli" ]; then
  unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_WORKSPACE_ID ANTHROPIC_BASE_URL
fi

# Run the build, and keep it current. A build older than the sources is the
# previous version of the program: after a pull or a branch switch it answers
# "unknown command" to anything new, and the web app, which imports the build,
# runs the old engine. So a missing or stale build is rebuilt first - once, a
# few seconds - and only if that fails do we fall back to running the sources.
TSC=node_modules/typescript/bin/tsc
if [ ! -f dist/cli/index.js ] || [ -n "$(find src -name '*.ts' -newer dist/cli/index.js 2>/dev/null | head -n 1)" ]; then
  if [ -f "$TSC" ]; then
    echo "all-int: the code changed since the last build; rebuilding (a few seconds)..." >&2
    if node "$TSC" -p tsconfig.json >&2; then
      # Mark the build current even if the compiler left this file untouched.
      touch dist/cli/index.js
    else
      echo "all-int: the build failed; running from source instead." >&2
      exec npx tsx src/cli/index.ts "$@"
    fi
  else
    echo "all-int: packages are not installed. Run: npm install   (in $ROOT)" >&2
    exit 1
  fi
fi
exec node dist/cli/index.js "$@"

{
  "name": "all-int",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal geopolitics/business/tech intelligence system that links events into followable storylines.",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "all-int": "./bin/all-int"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
    "tl": "tsx src/cli/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "web": "npm run dev --workspace web"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "better-sqlite3": "^12.2.0",
    "cheerio": "^1.1.2",
    "commander": "^14.0.1",
    "fast-xml-parser": "^5.2.5",
    "pdfjs-dist": "^4.10.38",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "workspaces": [
    "web"
  ]
}

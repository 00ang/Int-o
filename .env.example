# Required by SEC EDGAR and several other government hosts, which throttle or
# refuse traffic that does not identify itself.
ALLINT_CONTACT_EMAIL=you@example.com

# Needed for extract, threads:update and brief. Ingestion and search work without it.
ANTHROPIC_API_KEY=
# Only for an identity-linked key, which the API rejects without it.
ANTHROPIC_WORKSPACE_ID=

# Optional
ALLINT_DB=./data/allint.db
ALLINT_MODEL=claude-opus-5
ALLINT_EXTRACT_LIMIT=40
ALLINT_HOST_DELAY_MS=400

# Free key from https://api.data.gov
CONGRESS_GOV_API_KEY=
# Free token from https://www.courtlistener.com
COURTLISTENER_API_TOKEN=

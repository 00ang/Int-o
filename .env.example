# Required by SEC EDGAR and several other government hosts, which throttle or
# refuse traffic that does not identify itself.
ALLINT_CONTACT_EMAIL=you@example.com

# Needed for extract, threads:update and brief. Ingestion and search work without it.
ANTHROPIC_API_KEY=
# Only for an identity-linked key, which the API rejects without it.
ANTHROPIC_WORKSPACE_ID=

# Optional
ALLINT_DB=./data/allint.db
ALLINT_MODEL=claude-opus-5-5
# Extraction runs once per retained item and is most of the spend. It holds up
# on a cheaper model; leave unset to use ALLINT_MODEL.
# ALLINT_EXTRACT_MODEL=claude-sonnet-5-5
ALLINT_EXTRACT_LIMIT=40
ALLINT_HOST_DELAY_MS=400

# Free key from https://api.data.gov
CONGRESS_GOV_API_KEY=
# Free token from https://www.courtlistener.com
COURTLISTENER_API_TOKEN=
# Optional. Lobbying disclosures work without it at ~15 requests/minute.
# Free key: register on the API page at lda.senate.gov
LDA_API_KEY=

# Backend for model calls. `anthropic` bills per token against a credit
# balance; `claude-cli` runs the same models through a Claude Code
# subscription, which costs nothing at the margin but shares that
# subscription's rate limit.
ALLINT_LLM_PROVIDER=anthropic
ALLINT_CLI_MODEL=sonnet
ALLINT_CLI_TRIAGE_MODEL=haiku
# ALLINT_CLI_EXTRACT_MODEL=sonnet
